datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPERVISOR
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role
  siteId       String? // Nullable for Admin, required for Supervisor if assigned to a site
  site         Site?       @relation("SiteSupervisors", fields: [siteId], references: [id], onDelete: SetNull)
  acknowledges Violation[] @relation("ViolationAck")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Site {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String
  supervisors User[]   @relation("SiteSupervisors")
  workers     Worker[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Worker {
  id           String      @id // Custom ID like WRK0001
  name         String
  jobProfile   String
  department   String
  mobileNumber String
  aadharNumber String
  siteId       String
  site         Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  violations   Violation[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Violation {
  id               String    @id @default(uuid())
  workerId         String
  worker           Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type             String // e.g. "No Helmet", "No Safety Vest", "No Safety Harness", "No Gloves", "No Safety Boots"
  timestamp        DateTime  @default(now())
  severity         Severity  @default(MEDIUM)
  isAcknowledged   Boolean   @default(false)
  acknowledgedById String?
  acknowledgedBy   User?     @relation("ViolationAck", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
